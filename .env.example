# ---------------------------------------------------------------------------
# Hostel Management System — environment configuration
# Copy this file to `.env` and adjust. NEVER commit your real `.env`.
# ---------------------------------------------------------------------------

# Database backend: "sqlite" (default, zero-config) or "mysql"
HMS_DB_BACKEND=sqlite

# SQLite database file path (used when HMS_DB_BACKEND=sqlite)
HMS_SQLITE_PATH=hostel.db

# --- MySQL settings (used only when HMS_DB_BACKEND=mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hostel_management

# --- Web / security ---
# Generate a strong value in production, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
HMS_SECRET_KEY=dev-secret-change-me

# Password gating the "Authorities only" admin actions
HMS_ADMIN_PASSWORD=admin

# Enable Flask debug mode (NEVER enable in production)
HMS_DEBUG=false
